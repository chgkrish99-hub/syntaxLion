# Copy this file to .env in your project root and fill in your own values
# from your EmailJS dashboard (emailjs.com).
# NOTE: react-scripts only exposes vars prefixed with REACT_APP_, and you
# must fully restart `npm start` after creating/editing this file.

REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here
